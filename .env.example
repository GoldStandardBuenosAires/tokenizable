
# ---------------------------------------------------------------------------
# Tokenizable — environment template. Copy to .env and fill in. NEVER commit .env
# ---------------------------------------------------------------------------

# Polygon Amoy testnet RPC (defaults to https://rpc-amoy.polygon.technology)
AMOY_RPC_URL=

# Polygon mainnet RPC (defaults to https://polygon-bor-rpc.publicnode.com)
POLYGON_RPC_URL=

# Deployer private key — ONLY needed for testnet/mainnet contract deployment.
# Local Hardhat development uses the built-in unlocked accounts, no key required.
PRIVATE_KEY=

# Set by the host (Vercel) — "production" makes the frontend read
# public/deployment.json + a live public RPC instead of the local Hardhat node.
VITE_VERCEL_ENV=

# Privy app id for the email-first embedded wallet path
VITE_PRIVY_APP_ID=cmst8z6o800qh0cl1i2fvoh2h

# WalletConnect project id used by RainbowKit (optional for local dev)
VITE_WALLETCONNECT_PROJECT_ID=
